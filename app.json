{
  "expo": {
    "name": "Бурятский",
    "slug": "buryat-duolingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buryatduolingo",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#009CD2",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#009CD2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "baseUrl": "/buryat_learning",
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
